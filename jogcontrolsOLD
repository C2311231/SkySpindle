            <div class="xy incrementLarge">

                <button class="xyBTN X0"></button>
                <button class="xyBTN Y0"></button>
                <button class="xyBTN X1"></button>
                <button class="xyBTN Y1"></button>
            </div>
            <div class="xy incrementMedium">
                <button class="xyBTN X0"></button>
                <button class="xyBTN Y0"></button>
                <button class="xyBTN X1"></button>
                <button class="xyBTN Y1"></button>
            </div>
            <div class="xy incrementsmall">
                <button class="xyBTN X0"><p>X-</p></button>
                <button class="xyBTN Y0"><p>Y-</p></button>
